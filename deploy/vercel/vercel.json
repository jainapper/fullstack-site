{
  "rewrites": [
    { "source": "/:path*", "destination": "https://jainapper.github.io/fullstack-site/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    }
  ]
}
